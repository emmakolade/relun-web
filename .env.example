# Relun API (relun-backend). Leave unset in development: Vite proxies /api and /socket.io
# to http://localhost:9000. Set it for production builds.
# VITE_API_BASE_URL=https://api.relun.chat/

# Web push (Firebase Cloud Messaging). Firebase console > Project settings:
# add a Web app for the first four; Cloud Messaging > Web Push certificates
# for the VAPID key. Without them web push stays off and nothing else changes.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_VAPID_KEY=

# Error reporting (Sentry) and product analytics (PostHog). Both stay off when
# unset. Neither records sessions or sends names, contact details or chat text.
# VITE_SENTRY_DSN=
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://us.i.posthog.com
